  sender          User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientMessageId String           @map("client_message_id")
  body            String           @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([sessionId, senderId, clientMessageId])
  @@index([sessionId, createdAt])
  @@index([senderId])
  @@map("live_class_chat_messages")
}

model LiveClassWhiteboardEvent {
  id        String           @id @default(cuid())
  sessionId String           @map("session_id")
  session   LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId  String           @map("author_id")
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sequence  Int
  kind      String           @db.VarChar(32)
  payload   Json?
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@index([authorId])
  @@map("live_class_whiteboard_events")
}

model PjjIntervention {
  id          String    @id @default(cuid())
