  startsAt    DateTime?      @map("starts_at") @db.Date
  endsAt      DateTime?      @map("ends_at") @db.Date
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([classRoomId, teacherId, subject, role])
  @@index([teacherId, isActive])
  @@map("class_teacher_assignments")
}

model LiveClassSession {
  id                        String             @id @default(cuid())
  classRoomId               String             @map("class_room_id")
  classRoom                 ClassRoom          @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  createdById               String             @map("created_by_id")
  createdBy                 User               @relation("LiveClassCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendanceSessionId       String?            @unique @map("attendance_session_id")
  attendanceSession         AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)
  roomName                  String             @unique @map("room_name")
  title                     String
  subject                   String
  description               String?            @db.Text
  scheduledStart            DateTime           @map("scheduled_start")
  scheduledEnd              DateTime           @map("scheduled_end")
  actualStart               DateTime?          @map("actual_start")
  actualEnd                 DateTime?          @map("actual_end")
  status                    LiveClassStatus    @default(SCHEDULED)
  roomMode                  LiveRoomMode       @default(MEETING) @map("room_mode")
  maxParticipants           Int                @default(50) @map("max_participants")
  minAttendancePercent      Int                @default(70) @map("min_attendance_percent")
  recordingUrl              String?            @map("recording_url") @db.Text
  whiteboardVersion         Int                @default(0) @map("whiteboard_version")
  whiteboardSnapshotVersion Int                @default(0) @map("whiteboard_snapshot_version")
  whiteboardSnapshot        Json?              @map("whiteboard_snapshot")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  participants     LiveClassParticipant[]
  questions        LiveClassQuestion[]
  chatMessages     LiveClassChatMessage[]
  whiteboardEvents LiveClassWhiteboardEvent[]
  quizzes          LiveClassQuiz[]

  @@index([classRoomId, scheduledStart])
  @@index([status, scheduledStart])
  @@map("live_class_sessions")
}

model LiveClassParticipant {
  id                    String               @id @default(cuid())
  sessionId             String               @map("session_id")
  session               LiveClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId                String               @map("user_id")
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId             String?              @map("student_id")
  student               Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  role                  LiveParticipantRole
  canPublishMedia       Boolean              @default(false) @map("can_publish_media")
  firstJoinedAt         DateTime?            @map("first_joined_at")
  lastJoinedAt          DateTime?            @map("last_joined_at")
  lastLeftAt            DateTime?            @map("last_left_at")
  liveKitParticipantSid String?              @map("livekit_participant_sid")
  totalSeconds          Int                  @default(0) @map("total_seconds")
  joinCount             Int                  @default(0) @map("join_count")
  connectionQuality     String?              @map("connection_quality")
  attendanceStatus      LiveAttendanceStatus @default(NEEDS_REVIEW) @map("attendance_status")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  @@unique([sessionId, userId])
  @@index([studentId, attendanceStatus])
  @@map("live_class_participants")
}

model LiveClassQuiz {
  id          String           @id @default(cuid())
  sessionId   String           @map("session_id")
  session     LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdById String           @map("created_by_id")
  createdBy   User             @relation("LiveClassQuizCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title       String
  status      LiveQuizStatus   @default(DRAFT)
  durationSec Int              @default(120) @map("duration_sec")
  launchedAt  DateTime?        @map("launched_at")
  closedAt    DateTime?        @map("closed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  questions LiveClassQuizQuestion[]
  attempts  LiveClassQuizAttempt[]

  @@index([sessionId, status, createdAt])
  @@map("live_class_quizzes")
}

model LiveClassQuizQuestion {
  id                 String        @id @default(cuid())
  quizId             String        @map("quiz_id")
  quiz               LiveClassQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt             String        @db.Text
  options            Json
  correctOptionIndex Int           @map("correct_option_index")
  points             Int           @default(1)
  sortOrder          Int           @default(0) @map("sort_order")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  answers LiveClassQuizAnswer[]

  @@index([quizId, sortOrder])
  @@map("live_class_quiz_questions")
}

model LiveClassQuizAttempt {
  id          String                @id @default(cuid())
  quizId      String                @map("quiz_id")
  quiz        LiveClassQuiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String                @map("student_id")
  student     Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Float                 @default(0)
  status      LiveQuizAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime              @default(now()) @map("started_at")
  submittedAt DateTime?             @map("submitted_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  answers LiveClassQuizAnswer[]

  @@unique([quizId, studentId])
  @@index([studentId, createdAt])
  @@map("live_class_quiz_attempts")
}

model LiveClassQuizAnswer {
  id            String                @id @default(cuid())
  attemptId     String                @map("attempt_id")
  attempt       LiveClassQuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String                @map("question_id")
  question      LiveClassQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int                   @map("selected_index")
  isCorrect     Boolean               @default(false) @map("is_correct")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@unique([attemptId, questionId])
  @@map("live_class_quiz_answers")
}

model LiveClassQuestion {
  id          String             @id @default(cuid())
  sessionId   String             @map("session_id")
  session     LiveClassSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId   String?            @map("student_id")
  student     Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  body        String             @db.Text
  isHandRaise Boolean            @default(false) @map("is_hand_raise")
  status      LiveQuestionStatus @default(OPEN)
  createdAt   DateTime           @default(now()) @map("created_at")
  answeredAt  DateTime?          @map("answered_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([sessionId, status, createdAt])
  @@index([userId, createdAt])
  @@map("live_class_questions")
}

model LiveClassChatMessage {
  id              String           @id @default(cuid())
  sessionId       String           @map("session_id")
  session         LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
