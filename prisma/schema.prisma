model MerchantStore {
  id               String             @id @default(cuid())
  userId           String             @unique @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  slug             String             @unique
  description      String?            @db.Text
  address          String?            @db.Text
  city             String?
  bankName         String?            @map("bank_name")
  bankAccount      String?            @map("bank_account")
  bankHolder       String?            @map("bank_holder")
  flatShippingFee  Decimal            @default(0) @map("flat_shipping_fee") @db.Decimal(12, 2)
  status           MerchantStoreStatus @default(PENDING_REVIEW)
  rejectionNote    String?            @map("rejection_note") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  products  MarketplaceProduct[]
  subOrders MarketplaceSubOrder[]
  cartItems MarketplaceCartItem[]

  @@index([status])
  @@map("merchant_stores")
}

model MarketplaceProduct {
  id              String                   @id @default(cuid())
  storeId         String                   @map("store_id")
  store           MerchantStore            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind            MarketplaceProductKind
  title           String
  slug            String
  description     String?                  @db.Text
  price           Decimal                  @db.Decimal(12, 2)
  stock           Int                      @default(0)
  imageUrl        String?                  @map("image_url")
  digitalFileKey  String?                  @map("digital_file_key")
  digitalFileName String?                  @map("digital_file_name")
  status          MarketplaceProductStatus @default(DRAFT)
  rejectionNote   String?                  @map("rejection_note") @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  cartItems MarketplaceCartItem[]
  orderItems MarketplaceOrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([status, kind])
  @@map("marketplace_products")
}

model MarketplaceCartItem {
  id        String            @id @default(cuid())
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String            @map("product_id")
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String            @map("store_id")
  store     MerchantStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quantity  Int               @default(1)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("marketplace_cart_items")
}

model MarketplaceOrder {
  id               String                 @id @default(cuid())
  buyerId          String                 @map("buyer_id")
  buyer            User                   @relation("MarketplaceOrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerType        MarketplaceBuyerType
  schoolId         String?                @map("school_id")
  school           School?                @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  status           MarketplaceOrderStatus @default(PENDING)
  shippingName     String                 @map("shipping_name")
  shippingPhone    String                 @map("shipping_phone")
  shippingAddress  String                 @map("shipping_address") @db.Text
  shippingCity     String?                @map("shipping_city")
  amount           Decimal                @db.Decimal(12, 2)
  gatewayId        String                 @map("gateway_id")
  gateway          PaymentGateway         @relation(fields: [gatewayId], references: [id])
  gatewayRef       String                 @unique @map("gateway_ref")
  paidAt           DateTime?              @map("paid_at")
  metadata         Json?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  items     MarketplaceOrderItem[]
  subOrders MarketplaceSubOrder[]

  @@index([buyerId, status])
  @@index([status, createdAt])
  @@map("marketplace_orders")
}

model MarketplaceSubOrder {
  id              String                    @id @default(cuid())
  orderId         String                    @map("order_id")
  order           MarketplaceOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId         String                    @map("store_id")
  store           MerchantStore             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  status          MarketplaceSubOrderStatus @default(PENDING)
  goodsAmount     Decimal                   @map("goods_amount") @db.Decimal(12, 2)
  shippingAmount  Decimal                   @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  courier         String?
  trackingNumber  String?                   @map("tracking_number")
  shippedAt       DateTime?                 @map("shipped_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  items MarketplaceOrderItem[]

  @@index([storeId, status])
  @@index([orderId])
  @@map("marketplace_sub_orders")
}

model MarketplaceOrderItem {
  id              String              @id @default(cuid())
  orderId         String              @map("order_id")
  order           MarketplaceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId      String              @map("sub_order_id")
  subOrder        MarketplaceSubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  productId       String              @map("product_id")
  product         MarketplaceProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind            MarketplaceProductKind
  title           String
  unitPrice       Decimal             @map("unit_price") @db.Decimal(12, 2)
  quantity        Int
  digitalFileKey  String?             @map("digital_file_key")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("marketplace_order_items")
}
