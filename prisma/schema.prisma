model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String            @map("password_hash")
  authVersion      Int               @default(0) @map("auth_version")
  name             String
  role             UserRole          @default(TEACHER)
  schoolId         String?           @map("school_id")
  school           School?           @relation(fields: [schoolId], references: [id])
  provinceId       String?           @map("province_id")
  province         Province?         @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  nip              String?
  phone            String?
  avatarUrl        String?           @map("avatar_url")
  creditsRemaining Int               @default(10) @map("credits_remaining")
  walletBalance    Decimal           @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  planId           String?           @map("plan_id")
  plan             SubscriptionPlan? @relation(fields: [planId], references: [id])
  planExpiresAt    DateTime?         @map("plan_expires_at")
  profileDefaults  Json?             @map("profile_defaults")
  emailVerifiedAt  DateTime?         @map("email_verified_at")
  referralCode     String?           @unique @map("referral_code")
  referredById     String?           @map("referred_by_id")
  referredBy       User?             @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]            @relation("UserReferrals")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  documents                      Document[]
  aiUsageLogs                    AiUsageLog[]
  transactions                   Transaction[]
  schoolPaymentTransactions      SchoolPaymentTransaction[]   @relation("SchoolPaymentCreator")
  classRooms                     ClassRoom[]
  attendanceSessions             AttendanceSession[]
  dailyJournals                  DailyJournal[]
  assessments                    Assessment[]
  assignments                    Assignment[]
  quizzes                        Quiz[]
  dailyQuizzesCreated            DailyQuiz[]                  @relation("DailyQuizCreator")
  exams                          Exam[]
  studentBoardPosts              StudentBoardPost[]           @relation("StudentBoardAuthor")
  reviewedStudentBoardPosts      StudentBoardPost[]           @relation("StudentBoardReviewer")
  studentBoardPostLikes          StudentBoardPostLike[]
  studentBoardPostComments       StudentBoardPostComment[]
  studentBoardPostBookmarks      StudentBoardPostBookmark[]
  studentBoardPostReports        StudentBoardPostReport[]     @relation("StudentBoardPostReporter")
  reviewedStudentSpotlights      StudentSpotlightSubmission[] @relation("StudentSpotlightReviewer")
  studentSpotlightReports        StudentSpotlightReport[]     @relation("StudentSpotlightReporter")
  reviewedSpotlightReports       StudentSpotlightReport[]     @relation("StudentSpotlightReportReviewer")
  spotlightPosts                 SpotlightPost[]
  spotlightLikes                 SpotlightLike[]
  spotlightComments              SpotlightComment[]
  studentSpotlightLikes          StudentSpotlightLike[]
  affiliateProfile               AffiliateProfile?
  affiliateReferrals             AffiliateReferral[]          @relation("AffiliateOwner")
  affiliateReferralReceived      AffiliateReferral?           @relation("AffiliateReferred")
  affiliateCommissions           AffiliateCommission[]        @relation("AffiliateEarner")
  partnerCommissionsReceived     PartnerCommission[]          @relation("PartnerCommissionReferredUser")
  affiliatePayouts               AffiliatePayout[]
  creditLedger                   CreditLedger[]
  walletLedger                   WalletLedger[]
  rewardMissionClaims            RewardMissionClaim[]
  rewardAdSessions               RewardAdSession[]
  conversationParticipants       ConversationParticipant[]
  sentMessages                   Message[]
  whatsappLogs                   WhatsAppMessageLog[]
  otpCodes                       OtpCode[]
  teachingProfiles               TeacherSchoolProfile[]
  studentProfile                 Student?                     @relation("StudentUser")
  tkaQuestionsAuthored           TkaQuestion[]                @relation("TkaQuestionAuthor")
  tkaQuestionsReviewed           TkaQuestion[]                @relation("TkaQuestionReviewer")
  tkaPackagesAuthored            TkaPackage[]                 @relation("TkaPackageAuthor")
  tkaPackagesReviewed            TkaPackage[]                 @relation("TkaPackageReviewer")
  pjjProgramsCreated             PjjProgram[]                 @relation("PjjProgramCreator")
  pjjTeacherAssignments          ClassTeacherAssignment[]     @relation("PjjAssignedTeacher")
  liveClassSessionsCreated       LiveClassSession[]           @relation("LiveClassCreator")
  liveClassParticipations        LiveClassParticipant[]
  liveClassQuestions             LiveClassQuestion[]
  liveClassChatMessages          LiveClassChatMessage[]
  liveClassWhiteboardEvents      LiveClassWhiteboardEvent[]
  liveClassQuizzesCreated        LiveClassQuiz[]              @relation("LiveClassQuizCreator")
  pjjInterventionsCreated        PjjIntervention[]            @relation("PjjInterventionCreator")
  readingBooksCreated            ReadingBook[]                @relation("ReadingBookCreator")
  readingBooksReviewed           ReadingBook[]                @relation("ReadingBookReviewer")
  readingAssignments             ReadingAssignment[]          @relation("ReadingAssignmentTeacher")
  notificationsCreated           Notification[]               @relation("NotificationSender")
  notificationRecipients         NotificationRecipient[]
  pushDeviceTokens               PushDeviceToken[]
  studentFollowsSent             StudentFollow[]              @relation("StudentFollowFollower")
  studentFollowsReceived         StudentFollow[]              @relation("StudentFollowFollowing")
  studentBlocksCreated           StudentBlock[]               @relation("StudentBlockBlocker")
  studentBlocksReceived          StudentBlock[]               @relation("StudentBlockBlocked")
  studentMessageRequestsSent     StudentMessageRequest[]      @relation("StudentMessageRequestSender")
  studentMessageRequestsReceived StudentMessageRequest[]      @relation("StudentMessageRequestRecipient")
  schoolSeats                    SchoolSeat[]                 @relation("SchoolSeatUser")
  schoolSeatsAssigned            SchoolSeat[]                 @relation("SchoolSeatAssigner")
  schoolSubscriptionAudits       SchoolSubscriptionAudit[]    @relation("SchoolSubscriptionAuditActor")
  schoolCreditEntries            SchoolCreditLedger[]         @relation("SchoolCreditLedgerUser")
  schoolInvoicesCreated          SchoolInvoice[]              @relation("SchoolInvoiceCreator")
  schoolDocumentsCreated         SchoolAdminDocument[]        @relation("SchoolDocumentCreator")
  schoolDocumentsVerified        SchoolAdminDocument[]        @relation("SchoolDocumentVerifier")
  schoolDocumentsApproved        SchoolAdminDocument[]        @relation("SchoolDocumentApprover")
  schoolDocumentVersions         SchoolDocumentVersion[]      @relation("SchoolDocumentVersionCreator")
  schoolSchedulesCreated         SchoolSchedule[]             @relation("SchoolScheduleCreator")
  schoolScheduleSlots            SchoolScheduleSlot[]         @relation("SchoolScheduleSlotTeacher")
  schoolCalendarEvents           SchoolCalendarEvent[]        @relation("SchoolCalendarEventCreator")
  schoolDocumentTemplates        SchoolDocumentTemplate[]     @relation("SchoolDocumentTemplateCreator")
  merchantStore                  MerchantStore?
  marketplaceCartItems           MarketplaceCartItem[]
  marketplaceOrdersBought        MarketplaceOrder[]           @relation("MarketplaceOrderBuyer")

  @@index([provinceId])
  @@map("users")
}

model SecurityRateLimit {
  keyHash         String   @id @map("key_hash") @db.VarChar(64)
  bucket          String   @db.VarChar(64)
  count           Int      @default(0)
  windowStartedAt DateTime @map("window_started_at")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([bucket])
  @@index([expiresAt])
  @@map("security_rate_limits")
}

model School {
  id        String   @id @default(cuid())
  name      String
  npsn      String?  @unique
  level     String?
  address   String?  @db.Text
  city      String?
  province  String?
  regencyId String?  @map("regency_id")
  regency   Regency? @relation(fields: [regencyId], references: [id], onDelete: SetNull)
  logoUrl   String?  @map("logo_url")
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  classRooms          ClassRoom[]
  teacherProfiles     TeacherSchoolProfile[]
  affiliatePartners   AffiliatePartner[]
  tkaQuestions        TkaQuestion[]
  tkaPackages         TkaPackage[]
  pjjProgramLinks     PjjProgramSchool[]
  readingBooks        ReadingBook[]
  notifications       Notification[]
  subscriptions       SchoolSubscription[]
  seats               SchoolSeat[]
  subscriptionAudits  SchoolSubscriptionAudit[]
  creditLedger        SchoolCreditLedger[]
  invoices            SchoolInvoice[]
  paymentTransactions SchoolPaymentTransaction[]
  adminDocuments      SchoolAdminDocument[]
  schedules           SchoolSchedule[]
  calendarEvents      SchoolCalendarEvent[]
  pjjUsage            SchoolPjjUsage[]
  documentTemplates   SchoolDocumentTemplate[]
  marketplaceOrders   MarketplaceOrder[]

  @@index([regencyId])
  @@index([name])
  @@map("schools")
}

model TeacherSchoolProfile {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String?  @map("school_id")
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolName  String   @map("school_name")
  npsn        String?
  address     String?  @db.Text
  city        String?
  province    String?
  jenjang     String
  mapel       String
  tahunAjaran String   @map("tahun_ajaran")
  semester    String
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, isPrimary])
  @@index([schoolId])
  @@index([jenjang])
  @@map("teacher_school_profiles")
}

model Province {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  regencies Regency[]
  admins    User[]

  @@index([name])
  @@map("provinces")
}

model Regency {
  id         String   @id @default(cuid())
  provinceId String   @map("province_id")
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name       String
  code       String?  @unique
  type       String   @default("Kabupaten")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  schools           School[]
  affiliatePartners AffiliatePartner[]

  @@unique([provinceId, name])
  @@index([provinceId])
  @@index([name])
  @@map("regencies")
}

model AiProvider {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  baseUrl      String?  @map("base_url")
  apiKey       String   @map("api_key") @db.Text
  defaultModel String   @map("default_model")
  isActive     Boolean  @default(false) @map("is_active")
  isFallback   Boolean  @default(false) @map("is_fallback")
  maxTokens    Int      @default(4096) @map("max_tokens")
  temperature  Decimal  @default(0.70) @db.Decimal(3, 2)
  costPer1kIn  Decimal  @default(0) @map("cost_per_1k_in") @db.Decimal(10, 4)
  costPer1kOut Decimal  @default(0) @map("cost_per_1k_out") @db.Decimal(10, 4)
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  toolConfigs      AiToolConfig[]
  usageLogs        AiUsageLog[]
  balanceSnapshots AiProviderBalanceSnapshot[]

  @@map("ai_providers")
}

model AiToolConfig {
  id            String     @id @default(cuid())
  toolSlug      String     @map("tool_slug")
  toolName      String     @map("tool_name")
  category      String
  description   String?    @db.Text
  providerId    String     @map("provider_id")
  provider      AiProvider @relation(fields: [providerId], references: [id])
  modelOverride String?    @map("model_override")
  systemPrompt  String     @map("system_prompt") @db.LongText
  maxTokens     Int        @default(4096) @map("max_tokens")
  creditCost    Int        @default(1) @map("credit_cost")
  isActive      Boolean    @default(true) @map("is_active")
  sortOrder     Int        @default(0) @map("sort_order")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  documents Document[]

  @@unique([toolSlug])
  @@map("ai_tool_configs")
}

model ProviderClient {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  apiKeyHash         String               @unique @map("api_key_hash")
  status             ProviderClientStatus @default(ACTIVE)
  planName           String               @default("pilot") @map("plan_name")
  monthlyCreditLimit Int                  @default(1000) @map("monthly_credit_limit")
  usedCredits        Int                  @default(0) @map("used_credits")
  periodStart        DateTime             @default(now()) @map("period_start")
  periodEnd          DateTime?            @map("period_end")
  allowedTools       Json?                @map("allowed_tools")
  metadata           Json?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  usageLogs ProviderUsageLog[]

  @@index([status])
  @@map("provider_clients")
}

model ProviderUsageLog {
  id                String         @id @default(cuid())
  requestId         String         @map("request_id")
  providerClientId  String         @map("provider_client_id")
  providerClient    ProviderClient @relation(fields: [providerClientId], references: [id], onDelete: Cascade)
  toolSlug          String         @map("tool_slug")
  externalTenantId  String?        @map("external_tenant_id")
  externalUserId    String?        @map("external_user_id")
  externalRequestId String?        @map("external_request_id")
  status            String
  creditCharged     Int            @default(0) @map("credit_charged")
  providerUsed      String?        @map("provider_used")
  isDemo            Boolean        @default(false) @map("is_demo")
  latencyMs         Int?           @map("latency_ms")
  errorCode         String?        @map("error_code")
  errorMessage      String?        @map("error_message") @db.Text
  inputHash         String?        @map("input_hash")
  responseTitle     String?        @map("response_title")
  usageRequestId    String?        @map("usage_request_id")
  metadata          Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@unique([providerClientId, externalRequestId])
  @@index([providerClientId, createdAt])
  @@index([toolSlug, createdAt])
  @@index([status, createdAt])
  @@map("provider_usage_logs")
}

model PaymentGateway {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  isActive         Boolean  @default(false) @map("is_active")
  isDefault        Boolean  @default(false) @map("is_default")
  isSandbox        Boolean  @default(true) @map("is_sandbox")
  config           Json
  supportedMethods Json     @map("supported_methods")
  feeType          String   @default("percentage") @map("fee_type")
  feeAmount        Decimal  @default(0) @map("fee_amount") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  transactions              Transaction[]
  schoolPaymentTransactions SchoolPaymentTransaction[]
  marketplaceOrders         MarketplaceOrder[]

  @@map("payment_gateways")
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  priceMonthly   Decimal  @default(0) @map("price_monthly") @db.Decimal(12, 2)
  priceYearly    Decimal  @default(0) @map("price_yearly") @db.Decimal(12, 2)
  creditsMonthly Int      @default(0) @map("credits_monthly")
  features       Json?
  isActive       Boolean  @default(true) @map("is_active")
  isPopular      Boolean  @default(false) @map("is_popular")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users        User[]
  transactions Transaction[]

  @@map("subscription_plans")
}

model SchoolPlan {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  priceMonthly     Decimal  @default(0) @map("price_monthly") @db.Decimal(12, 2)
  priceYearly      Decimal  @default(0) @map("price_yearly") @db.Decimal(12, 2)
  maxTeacherSeats  Int      @default(0) @map("max_teacher_seats")
  maxStudents      Int      @default(0) @map("max_students")
  monthlyAiCredits Int      @default(0) @map("monthly_ai_credits")
  features         Json?
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  subscriptions       SchoolSubscription[]
  paymentTransactions SchoolPaymentTransaction[]

  @@map("school_plans")
}

model SchoolSubscription {
  id               String                   @id @default(cuid())
  schoolId         String                   @map("school_id")
  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId           String                   @map("plan_id")
  plan             SchoolPlan               @relation(fields: [planId], references: [id])
  status           SchoolSubscriptionStatus @default(TRIAL)
  startsAt         DateTime                 @default(now()) @map("starts_at")
  trialEndsAt      DateTime?                @map("trial_ends_at")
  currentPeriodEnd DateTime?                @map("current_period_end")
  graceEndsAt      DateTime?                @map("grace_ends_at")
  pjjAddOnEnabled  Boolean                  @default(false) @map("pjj_add_on_enabled")
  creditBalance    Int                      @default(0) @map("credit_balance")
  featureOverrides Json?                    @map("feature_overrides")
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  seats               SchoolSeat[]
  audits              SchoolSubscriptionAudit[]
  credits             SchoolCreditLedger[]
  invoices            SchoolInvoice[]
  paymentTransactions SchoolPaymentTransaction[]

  @@index([schoolId, status])
  @@index([planId])
  @@map("school_subscriptions")
}

model SchoolSeat {
  id             String             @id @default(cuid())
  subscriptionId String             @map("subscription_id")
