# Database (MySQL)
DATABASE_URL="mysql://root@localhost:3306/guru_space"

# App
NEXT_PUBLIC_APP_NAME="Guru Space"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
AUTH_SECRET="guru-space-auth-secret-dev-change-in-production-2025"

# Encryption key for API keys & gateway secrets (32+ chars)
ENCRYPTION_KEY="guru-space-encryption-key-32chars!!"

# LiveKit (opsional — dapat diatur lewat Super Admin > LiveKit PJJ)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# AI Providers (opsional — bisa juga via Super Admin)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""

# Midtrans Sandbox
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# Tripay Sandbox
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""

# Demo mode: template output jika AI tidak tersedia
DEMO_MODE="true"

# Guard untuk prisma db seed. Jangan aktifkan pada server production.
ALLOW_DEMO_SEED="false"

# Paket sekolah is fail-closed. Enable both only for selected pilot deployments
# after running the additive migration and preflight in the runbook.
SCHOOL_COMMERCIALIZATION_ENABLED="false"
NEXT_PUBLIC_SCHOOL_COMMERCIALIZATION_ENABLED="false"

# Sandbox: auto-activate payment tanpa webhook (dev only)
PAYMENT_AUTO_ACTIVATE_SANDBOX="false"
